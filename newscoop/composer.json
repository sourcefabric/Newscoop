{
    "require": {
        "doctrine/orm": "2.1.*",
        "symfony/console": "2.1.*",
        "symfony/yaml": "2.1.*",
        "bombayworks/zendframework1": "1.11.*",
        "guzzle/guzzle": "*",
        "rezzza/mailchimp": "dev-master",
        "hybridauth/hybridauth": "dev-master",
        "gedmo/doctrine-extensions":"=v2.1.0"
    },
    "repositories":[
        {
            "type":"package",
            "package":{
                "name":"gedmo/doctrine-extensions",
                "version":"2.1",
                "dist":{
                    "url":"https://github.com/l3pp4rd/DoctrineExtensions/zipball/v2.1.0",
                    "type":"zip"
                },
                "source":{
                    "url":"https://github.com/l3pp4rd/DoctrineExtensions.git",
                    "type":"git",
                    "reference":"tags/v2.1.0"
                }
            }
        }

    ],
    "autoload": {
        "psr-0": {
            "Newscoop": "library",
            "Resource": "library",
            "Nette": "library"
        },
        "classmap": [
            "classes",
            "include",
            "template_engine",
            "library/fabpot-dependency-injection-07ff9ba/lib",
            "library/fabpot-event-dispatcher-782a5ef/lib",
            "library/smarty3",
            "plugins"
        ]
    },
    "include-path": [
        "library", 
        "include", 
        "../dependencies/include"
    ]
}
