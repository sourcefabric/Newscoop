{
    "name":"sourcefabric/newscoop",
    "description":"The open source CMS for news",
    "keywords":[
        "cms",
        "journalism",
        "publication"
    ],
    "homepage":"http://www.sourcefabric.org/en/newscoop/",
    "version": "4.4.6",
    "license":"GPL-3.0",
    "authors":[
        
    ],
    "repositories":[
        {
            "type":"artifact",
            "url":"plugins/private_plugins"
        }
    ],
    "require":{
        "php":"^8.3",
        "symfony/symfony":"^7.2",
        "doctrine/orm":"^3.3",
        "doctrine/common":"^3.4",
        "doctrine/doctrine-bundle":"^2.13",
        "twig/twig":"^3.18",
        "twig/extensions":"^1.5",
        "symfony/assetic-bundle":"^2.8",
        "symfony/swiftmailer-bundle":"^3.5",
        "symfony/monolog-bundle":"^3.10",
        "sensio/framework-extra-bundle":"^6.2",
        "incenteev/composer-parameter-handler":"^2.2",
        "bombayworks/zendframework1":"1.12.*",
        "friendsofsymfony/rest-bundle":"^3.7",
        "kriswallsmith/buzz":"^1.2",
        "knplabs/knp-paginator-bundle":"^6.0",
        "knplabs/knp-components":"^5.0",
        "jms/serializer-bundle":"^5.5",
        "jms/serializer":"^3.32",
        "hybridauth/hybridauth":"^3.11",
        "smarty/smarty":"^5.4",
        "knplabs/knp-menu-bundle":"^3.5",
        "knplabs/knp-menu":"^3.6",
        "friendsofsymfony/jsrouting-bundle":"^3.5",
        "willdurand/js-translation-bundle":"^5.0",
        "imagine/imagine":"^1.5",
        "symfony/twig-bridge":"^7.2",
        "newscoop/recaptcha-bundle":"^3.0",
        "friendsofsymfony/oauth-server-bundle":"^2.0",
        "newscoop/plugins-installer":"^1.0",
        "nelmio/api-doc-bundle":"^5.2",
        "hellogerard/jobby":"^2.1",
        "dflydev/doctrine-orm-service-provider":"^2.0",
        "pimple/pimple":"^3.6",
        "sentry/sentry":"^4.9",
        "stof/doctrine-extensions-bundle":"^1.13",
        "ext-pdo":"*",
        "ext-mbstring":"*",
        "ext-gd":"*",
        "ext-xml":"*",
        "ext-curl":"*",
        "ext-zip":"*",
        "ext-redis":"*"
    },
    "require-dev":{
        "phpunit/phpunit":"^11.5",
        "phpspec/phpspec":"^7.0",
        "liip/rmt":"^1.6",
        "behat/behat":"^3.17",
        "behat/common-contexts":"^1.6",
        "behat/mink":"^1.12",
        "behat/mink-extension":"^2.3",
        "behat/mink-goutte-driver":"^2.1",
        "behat/mink-selenium2-driver":"^1.7",
        "fakerphp/faker":"^1.24",
        "raulfraile/ladybug-bundle":"^1.1"
    },
    "autoload":{
        "psr-4":{
            "Newscoop\\": "library/Newscoop/",
            "Newscoop\\Bundle\\": "src/Newscoop/",
            "Campsite\\": "classes/",
            "Resource\\": "library/Resource/",
            "Proxy\\": "library/Proxy/"
        },
        "classmap":[
            "include/Date.php",
            "include/File.php",
            "include/Mail.php",
            "include/System.php",
            "include/PEAR.php",
            "include/PEAR5.php"
        ],
        "files": [
            "include/campsite_constants.php",
            "include/campsite_init.php"
        ]
    },
    "scripts":{
        "post-install-cmd":[
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap"
        ],
        "post-update-cmd":[
            "Sensio\\Bundle\\DistributionBundle\\Composer\\ScriptHandler::buildBootstrap"
        ]
    },
    "minimum-stability":"stable",
    "config":{
        "bin-dir":"vendor/bin",
        "discard-changes":true,
        "process-timeout":3600,
        "allow-plugins": {
            "composer/installers": true,
            "newscoop/plugins-installer": true
        }
    },
    "extra":{
        "symfony-app-dir":"application",
        "symfony-web-dir":"public"
    },
    "branch-alias":{
        "dev-master":"4.4-dev"
    }
}
